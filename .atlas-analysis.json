  "keyFeatures": [
    "Bump major, minor, patch, alpha, beta, RC, and preview version components",
    "Supports multiple file formats: VERSION, package.json, go.mod, Dockerfile, Chart.yaml, pom.xml",
    "Fix malformed version strings automatically with -fix flag",
    "JSON output mode for pipeline integration",
    "Environment variable overrides for CI/CD automation",
    "Dry-run by default; -write flag commits changes to file",
    "Exit code 0/1 for pipeline flow control",
    "Cross-platform binaries: macOS (arm64/amd64), Linux (arm64/amd64), Windows"
  ],
  "publicApiSurface": [
    "bump.New() *Version",
    "bump.Parse(version string) (*Version, error)",
    "bump.Create(version, path string) (*Version, error)",
    "(*Version).LoadFile(path string) error",
