    "(*Version).BumpMajor()",
    "(*Version).BumpMinor()",
    "(*Version).BumpPatch()",
    "(*Version).BumpAlpha()",
    "(*Version).BumpBeta()",
    "(*Version).BumpRC()",
    "(*Version).BumpPreview()",
    "(*Version).Format(withPrefix bool) string",
    "(*Version).Save(path string) error",
    "(*Version).Compare(o *Version) int",
    "(*Version).String() string",
    "(*Version).SetRaw(raw []byte)",
    "(*Version).NoPrefix() bool",
    "(*Version).Raw() string"
  ]
